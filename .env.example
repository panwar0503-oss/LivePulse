NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://livepulse:change_me@localhost:5432/livepulse
# Integration tests only; the database name must end in _test
TEST_DATABASE_URL=postgres://livepulse:change_me@localhost:5432/livepulse_test
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
TRUST_PROXY=false
# Delay (ms, 0 to 60000) before a disconnect lowers the presence count, so a refresh does not flicker it
PRESENCE_GRACE_MS=5000
# Open live connections allowed per client address, and per session on one instance
SOCKET_MAX_PER_IP=20
SOCKET_MAX_PER_SESSION=500
# Web app: API base URL seen by the browser (public; never put a secret here). Next.js reads it from web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
POSTGRES_USER=livepulse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=livepulse
# AI (see requirements/ai-foundation). Keep LangSmith tracing variables (LANGSMITH_*, LANGCHAIN_TRACING_*) unset.
AI_ENABLED=true
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_DIM=384
# Knowledge search reranker: fake (default, offline) or local (one-time model download, same cache as embeddings)
RERANKER_PROVIDER=fake
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
AI_MAX_CONCURRENCY=2
AI_MAX_ATTEMPTS=3
AI_SESSION_TOKEN_BUDGET=200000
# Q&A similarity thresholds (0.5 to 1): duplicate detection and clustering
QNA_DUPLICATE_SIMILARITY=0.90
QNA_CLUSTER_SIMILARITY=0.75
# Optional; at least 32 characters. Without it the operator route answers 503.
OPERATOR_KEY=replace_with_32_plus_random_characters
# MCP server (see docs/guides/mcp-claude-desktop-setup.md). Set in the MCP client config, not here.
# LIVEPULSE_API_URL=http://localhost:4000
# LIVEPULSE_SESSION_ID=<your-session-id>
# LIVEPULSE_PRESENTER_KEY=<your-presenter-key>
